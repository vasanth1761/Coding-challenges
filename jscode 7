/**
 * @param {number[]} nums
 * @param {Function} fn
 * @param {number} init
 * @return {number}
 */
var reduce = function(nums, fn, init) {
    // Handle the case for an empty array
    if (nums.length === 0) {
        return init;
    }
    
    // Initialize `val` with the initial value
    let val = init;
    
    // Iterate through the `nums` array
    for (let i = 0; i < nums.length; i++) {
        // Update `val` using the reducer function `fn`
        val = fn(val, nums[i]);
    }
    
    // Return the final result
    return val;
};
